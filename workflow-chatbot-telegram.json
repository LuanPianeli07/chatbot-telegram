              "id": "a69b5d14-3c70-4e28-9f49-ad8e7c604143",
              "leftValue": "={{ Number($json.statusCode) >= 200 && Number($json.statusCode) < 300 && !!($json.body && $json.body.main) && typeof $json.body.main.temp === 'number' }}",
              "rightValue": "",
