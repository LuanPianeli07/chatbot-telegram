    {
      "id": "7e1f3a8b-9c2d-4b04-8f36-a4c9e8d70253",
      "name": "Mensagem fallback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst body = item.body || {};\nconst main = body.main || {};\nconst temp = Math.round(Number(main.temp));\nconst city = body.name;\nconst message = '🌤️ A temperatura em ' + city + ' é de ' + temp + '°C.';\n\nreturn [\n  {\n    json: {\n      message,\n      ok: true,\n      city,\n      temp,\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      }
    },
    {
      "id": "9f2a4b0c-ad3e-4c15-9047-b5dae9f81364",
      "name": "Google Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        1760,
        80
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "={{ 'Reescreva em português do Brasil, com tom curto e amigável. Não invente dados. Mantenha a cidade e a temperatura. Cidade: ' + $json.city + '. Temperatura: ' + $json.temp + '°C. Mensagem base: ' + $json.message + '. Responda somente JSON no formato {\"message\":\"...\",\"ok\":true}.' }}",
              "role": "user"
            }
          ]
        },
        "simplify": true,
        "jsonOutput": true,
        "options": {
          "temperature": 0.1,
          "maxOutputTokens": 256,
          "systemMessage": "Você reescreve avisos de clima em português do Brasil. Responda somente JSON válido no formato {\"message\":\"...\",\"ok\":true}. A message deve ser curta, amigável e conter a cidade e a temperatura em °C. Não invente cidade nem temperatura. Se não conseguir, responda {\"message\":\"\",\"ok\":false}."
        }
      },
      "credentials": {
        "googlePalmApi": {
          "name": "Google Gemini account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "a03b5c1d-be4f-4d26-a158-c6ebf0a92475",
      "name": "Escolher mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2060,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const fallbackItem = $('Mensagem fallback').first().json;\nlet message = fallbackItem.message;\n\nfunction fromObject(value, depth) {\n  if (value == null || depth > 5) return '';\n  if (typeof value === 'string') {\n    const trimmed = value.trim().replace(/^```(?:json)?/i, '').replace(/```$/i, '').trim();\n    if (!trimmed.startsWith('{')) return '';\n    try {\n      return fromObject(JSON.parse(trimmed), depth + 1);\n    } catch (error) {\n      return '';\n    }\n  }\n  if (typeof value !== 'object') return '';\n  if (value.ok === true && typeof value.message === 'string' && value.message.trim()) {\n    return value.message.trim();\n  }\n  const nestedKeys = ['text', 'content', 'output', 'response', 'data'];\n  for (const key of nestedKeys) {\n    const found = fromObject(value[key], depth + 1);\n    if (found) return found;\n  }\n  if (value.message && typeof value.message === 'object') {\n    const found = fromObject(value.message, depth + 1);\n    if (found) return found;\n  }\n  if (Array.isArray(value.candidates)) {\n    for (const candidate of value.candidates) {\n      const found = fromObject(candidate, depth + 1);\n      if (found) return found;\n    }\n  }\n  if (Array.isArray(value.parts)) {\n    for (const part of value.parts) {\n      const found = fromObject(part, depth + 1);\n      if (found) return found;\n    }\n  }\n  return '';\n}\n\nconst chosen = fromObject($input.first().json, 0);\nif (chosen) message = chosen;\n\nreturn [\n  {\n    json: { message },\n    pairedItem: { item: 0 },\n  },\n];\n"
      }
    },
