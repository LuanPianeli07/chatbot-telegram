      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "e47f3b92-1a58-4c06-9d27-8b6c5a4e3f21",
              "name": "queue",
              "value": "={{ (() => { const raw = String(($json.message && $json.message.text) || '').trim().toLowerCase(); const noAccent = raw.normalize('NFD').replace(/[\\u0300-\\u036f]/g, ''); const cleaned = noAccent.replace(/\\s*,\\s*/g, ',').replace(/\\s+/g, ' ').replace(/\\.+$/g, '').trim(); if (!cleaned) return ''; const parts = cleaned.split(',').map((part) => part.trim()).filter(Boolean); const city = parts[0] || ''; const uf = (parts[1] || '').replace(/\\s+/g, ''); let country = (parts[2] || 'br').replace(/\\s+/g, ''); if (country === 'brasil' || country === 'brazil') country = 'br'; if (!city) return ''; if (!uf) return city + ',br'; return city + ',' + uf + ',' + country; })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1b7e9c4a-5d28-4e63-8f70-a9c3d2e1b456",
      "name": "Formato válido",
